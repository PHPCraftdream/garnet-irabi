{# Interstitial gateway for outbound links. Renders either an "invalid URL"
   message or the confirmation panel with host + full URL + continue
   button. Surrounding layout (head, menus, scripts) is provided by
   HtmlLayout — this template emits only the page body.

   No React island here on purpose: the page itself sets
   meta referrer=no-referrer, the continue link adds
   rel="noopener noreferrer nofollow", and the destination URL was
   already validated server-side. #}
<div class="external-page" data-test-id="external-redirect">
    <h1 class="external-heading">{{ title }}</h1>

    {% if target_url is null %}
        <p class="external-invalid">{{ invalid_label }}</p>
        <a href="/" class="external-secondary-action">{{ cancel_label }}</a>
    {% else %}
        <p class="external-description">{{ description }}</p>
        <dl class="external-details">
            <div><dt class="external-term">{{ host_label }}:</dt> <dd class="external-host">{{ host_text }}</dd></div>
            <div><dt class="external-term">{{ full_label }}:</dt> <dd class="external-url">{{ target_url }}</dd></div>
        </dl>
        <div class="external-actions">
            <a
                href="{{ target_url }}"
                rel="noopener noreferrer nofollow"
                referrerpolicy="no-referrer"
                class="external-primary-action"
                data-test-id="external-continue"
            >{{ continue_label }}</a>
            <a href="/" class="external-secondary-action" data-test-id="external-cancel">{{ cancel_label }}</a>
        </div>
    {% endif %}
</div>
